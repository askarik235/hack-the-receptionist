# Copy this file to .env and fill in real values. Never commit .env.
# Generate a random secret in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Napster API key (dashboard > Keys). One key per Napster project: use the DEV project key
# locally and the PROD project key on Render.
NAPSTER_API_KEY=your-napster-api-key

# Public HTTPS address of this backend, no trailing slash. Napster calls our tool endpoints
# and webhook here, and fetches portraits from here during setup.
# Local: your ngrok static domain. Prod: your Render URL.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Shared secret Napster sends as a header on every tool call (set on the function by setup).
TOOL_SECRET=change-me-random-string

# Server-only secret used to derive per-player level codes. Never sent to Napster or the browser.
CODE_SECRET=change-me-another-random-string

# Webhook signing secret, shown once when you create the webhook in the Napster dashboard.
NAPSTER_WEBHOOK_SECRET=paste-from-dashboard

# Port the backend listens on locally.
PORT=3000
