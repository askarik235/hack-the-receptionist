{
  "name": "hack-the-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "Browser game about social engineering, built on the Napster Omniagent API.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "test": "npm test --workspaces --if-present",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend"
  }
}
